{
  "name": "duplexnt",
  "version": "0.0.0",
  "private": true,
  "description": "Двусторонний скан на сканере без дуплекса: два прохода по eSCL и сборка в PDF",
  "author": "gyuiltylizard",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --project node --project jsdom",
    "test:integration": "vitest run --project integration",
    "test:all": "npm run test && npm run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:sync": "node scripts/sync-design-tokens.ts && prettier --write src/renderer/src/styles/tokens.css",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "i18next": "26.4.2",
    "jiti": "2.7.0",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "dependencies": {
    "sharp": "0.35.4"
  }
}
