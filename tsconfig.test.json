{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "test/**/*",
    "scripts/**/*",
    "tooling/**/*",
    "*.config.ts",
    "src/core/**/*",
    "src/shared/**/*"
  ],
  // Снимок дизайна рендерит renderer (DOM, JSX) — у него свой tsconfig.design.json (B-6).
  "exclude": ["test/design-snapshot/**/*"]
}
